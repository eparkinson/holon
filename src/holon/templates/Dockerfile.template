# Holon Agent Runtime Container
# This Dockerfile template is used to containerize Holon agents for deployment

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy holon package source and make it available
COPY holon /app/holon
ENV PYTHONPATH=/app:$PYTHONPATH

# Copy the agent definition and runtime files
COPY agent.md /app/agent.md
COPY runtime_entrypoint.py /app/runtime_entrypoint.py

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Run the agent
CMD ["python", "runtime_entrypoint.py", "/app/agent.md"]
